<?xml version="1.0" encoding="utf-8"?>
<!-- The only network traffic is the optional AI advisor, sent to an address
     the user types in. Plain http is allowed so a self-hosted model on the
     local network (e.g. http://192.168.1.10:11434/v1) works. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
